{
  "private": true,
  "license": "Apache-2.0",
  "name": "kyma-price-calculator",
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://kyma-project.github.io/price-calculator",
  "scripts": {
    "start": "vite",
    "build": "INLINE_RUNTIME_CHUNK=false GENERATE_SOURCEMAP=false NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "preview": "vite preview --port 3000",
    "deploy": "gh-pages -d build",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "eslint-check": "eslint src/",
    "lint-check": "prettier --config ./.prettierrc --ignore-path ./.prettierignore --check '**/*.{ts,tsx,js,jsx,json,html,css,yaml,md}'",
    "lint-fix": "prettier --config ./.prettierrc --ignore-path ./.prettierignore --write '**/*.{ts,tsx,js,jsx,json,html,css,yaml,md}'",
    "lint-staged": "lint-staged --concurrent=false"
  },
  "dependencies": {
    "@ui5/webcomponents": "^2.27.2",
    "@ui5/webcomponents-base": "^2.27.2",
    "@ui5/webcomponents-fiori": "^2.27.2",
    "@ui5/webcomponents-icons": "^2.27.2",
    "@ui5/webcomponents-react": "^2.27.3",
    "jotai": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.2.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-eslint2": "^5.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.22.1 || ^24.0.0 || >=26.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,html,css,scss,yaml,md}": "prettier --write"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
